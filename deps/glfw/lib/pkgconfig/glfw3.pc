prefix=
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.5.1
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw
Libs.private: -framework Cocoa -framework CoreVideo -framework IOKit -framework QuartzCore -framework CoreFoundation
Cflags: -I${includedir}
